{
  "info": {
    "name": "Blog API - EmbarkX",
    "description": "Blog API with JPA entity and service layer. Each post has: id (UUID), title (string), content (string), createdAt (ISO LocalDateTime). Validation: title 3-100 chars, content 50-5000 chars. H2 in-memory database. HTTP Status: 201 Created, 200 OK, 404 Not Found, 400 Bad Request",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Post - Success",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts?title=My First Post&content=This is the content of my first post that is long enough to meet the minimum fifty character requirement",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "posts"
          ],
          "query": [
            {
              "key": "title",
              "value": "My First Post"
            },
            {
              "key": "content",
              "value": "This is the content of my first post that is long enough to meet the minimum fifty character requirement"
            }
          ],
          "protocol": "http"
        }
      }
    },
